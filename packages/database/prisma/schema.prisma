datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum GlobalRole {
  USER
  SUPERADMIN
}

enum WorldRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum PropertyType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  CARD_REFERENCE
}

model User {
  id             String                   @id @default(uuid())
  email          String                   @unique
  passwordHash   String?                  // Nullable para autenticação exclusiva via OAuth
  name           String
  avatarUrl      String?
  isVerified     Boolean                  @default(false)
  globalRole     GlobalRole               @default(USER)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  memberships    WorldMember[]
  createdInvites Invitation[]             @relation("InvitedBy")
  verifyTokens   EmailVerificationToken[]
  resetTokens    PasswordResetToken[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique // Hash SHA-256 do token rotacionado
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "google", "discord", "github"
  providerAccountId String
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model World {
  id                  String               @id @default(uuid())
  name                String
  slug                String               @unique
  description         String?
  coverUrl            String?
  deletedAt           DateTime?            // Soft-delete
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  members             WorldMember[]
  invitations         Invitation[]
  folders             Folder[]
  cardTypes           CardType[]
  propertyDefinitions PropertyDefinition[]
  cards               Card[]
  documents           Document[]
  propertyValues      CardPropertyValue[]
  mentions            Mention[]
  timelines           Timeline[]
  timelineEvents      TimelineEvent[]
  timelineEventCards  TimelineEventCard[]
  documentVersions    DocumentVersion[]

  @@index([deletedAt])
  @@map("worlds")
}

model WorldMember {
  id        String    @id @default(uuid())
  worldId   String
  userId    String
  role      WorldRole @default(EDITOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
  @@index([userId])
  @@map("world_members")
}

model Invitation {
  id          String    @id @default(uuid())
  worldId     String
  email       String
  role        WorldRole @default(EDITOR)
  token       String    @unique
  invitedById String
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([worldId, email])
  @@index([token])
  @@map("invitations")
}

model Folder {
  id        String    @id @default(uuid())
  worldId   String
  parentId  String?
  name      String
  icon      String?
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  world     World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId, worldId], references: [id, worldId], onDelete: Cascade)
  children  Folder[]  @relation("FolderHierarchy")
  cards     Card[]
  timelines Timeline[]

  @@unique([id, worldId])
  @@index([worldId, parentId])
  @@index([deletedAt])
  @@map("folders")
}

model CardType {
  id            String               @id @default(uuid())
  worldId       String
  parentTypeId  String?
  name          String
  slug          String
  icon          String?
  color         String?
  defaultBlocks Json?
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  world         World                @relation(fields: [worldId], references: [id], onDelete: Cascade)
  parentType    CardType?            @relation("TypeSubtypes", fields: [parentTypeId, worldId], references: [id, worldId], onDelete: Cascade)
  subtypes      CardType[]           @relation("TypeSubtypes")
  properties    PropertyDefinition[]
  cards         Card[]

  @@unique([id, worldId])
  @@unique([worldId, slug])
  @@index([deletedAt])
  @@map("card_types")
}

model PropertyDefinition {
  id         String              @id @default(uuid())
  cardTypeId String
  worldId    String
  name       String
  slug       String
  type       PropertyType
  options    Json?
  isRequired Boolean             @default(false)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  world      World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  cardType   CardType            @relation(fields: [cardTypeId, worldId], references: [id, worldId], onDelete: Cascade)
  values     CardPropertyValue[]

  @@unique([id, worldId])
  @@unique([cardTypeId, slug])
  @@index([worldId])
  @@map("property_definitions")
}

model Document {
  id          String    @id @default(uuid())
  worldId     String
  yjsState    Bytes?
  contentJson Json?
  plainText   String    @default("") @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  world       World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  card        Card?
  versions    DocumentVersion[]

  @@unique([id, worldId])
  @@index([worldId])
  @@index([deletedAt])
  @@map("documents")
}

model Card {
  id               String              @id @default(uuid())
  worldId          String
  cardTypeId       String
  folderId         String?
  parentCardId     String?
  documentId       String              @unique
  title            String
  slug             String
  aliases          String[]            @default([])
  summary          String?
  coverUrl         String?
  icon             String?
  isPublished      Boolean             @default(false)
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  world            World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  cardType         CardType            @relation(fields: [cardTypeId, worldId], references: [id, worldId], onDelete: Restrict)
  folder           Folder?             @relation(fields: [folderId, worldId], references: [id, worldId], onDelete: Cascade)
  parentCard       Card?               @relation("NestedCards", fields: [parentCardId, worldId], references: [id, worldId], onDelete: Cascade)
  childCards       Card[]              @relation("NestedCards")
  document         Document            @relation(fields: [documentId, worldId], references: [id, worldId], onDelete: Cascade)
  properties       CardPropertyValue[]
  referencedBy     CardPropertyValue[] @relation("ReferencedTargetCard")
  outgoingMentions Mention[]           @relation("OutgoingMentions")
  incomingMentions Mention[]           @relation("IncomingMentions")
  timelineEvents   TimelineEvent[]
  timelineEventCards TimelineEventCard[]
  documentVersions DocumentVersion[]

  @@unique([id, worldId])
  @@unique([documentId, worldId])
  @@unique([worldId, slug])
  @@index([worldId, folderId])
  @@index([worldId, cardTypeId])
  @@index([worldId, parentCardId])
  @@index([deletedAt])
  @@map("cards")
}

model CardPropertyValue {
  id           String             @id @default(uuid())
  worldId      String
  cardId       String
  propertyId   String
  value        Json
  targetCardId String?

  world        World              @relation(fields: [worldId], references: [id], onDelete: Cascade)
  card         Card               @relation(fields: [cardId, worldId], references: [id, worldId], onDelete: Cascade)
  property     PropertyDefinition @relation(fields: [propertyId, worldId], references: [id, worldId], onDelete: Cascade)
  targetCard   Card?              @relation("ReferencedTargetCard", fields: [targetCardId, worldId], references: [id, worldId], onDelete: Cascade)

  @@unique([cardId, propertyId])
  @@index([worldId, targetCardId])
  @@map("card_property_values")
}

model Mention {
  id           String   @id @default(uuid())
  worldId      String
  sourceCardId String
  targetCardId String
  contextText  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  world        World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  sourceCard   Card     @relation("OutgoingMentions", fields: [sourceCardId, worldId], references: [id, worldId], onDelete: Cascade)
  targetCard   Card     @relation("IncomingMentions", fields: [targetCardId, worldId], references: [id, worldId], onDelete: Cascade)

  @@unique([sourceCardId, targetCardId])
  @@index([worldId, sourceCardId])
  @@index([worldId, targetCardId])
  @@map("mentions")
}

model Timeline {
  id          String          @id @default(uuid())
  worldId     String
  folderId    String?
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  world       World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  folder      Folder?         @relation(fields: [folderId, worldId], references: [id, worldId], onDelete: SetNull)
  events      TimelineEvent[]

  @@unique([id, worldId])
  @@index([worldId])
  @@index([worldId, folderId])
  @@index([deletedAt])
  @@map("timelines")
}

model TimelineEvent {
  id          String              @id @default(uuid())
  worldId     String
  timelineId  String
  cardId      String?
  title       String
  description String?             @db.Text
  dateText    String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  world       World               @relation(fields: [worldId], references: [id], onDelete: Cascade)
  timeline    Timeline            @relation(fields: [timelineId, worldId], references: [id, worldId], onDelete: Cascade)
  card        Card?               @relation(fields: [cardId, worldId], references: [id, worldId], onDelete: SetNull)
  eventCards  TimelineEventCard[]

  @@unique([id, worldId])
  @@index([worldId, timelineId])
  @@index([worldId, cardId])
  @@index([deletedAt])
  @@map("timeline_events")
}

model TimelineEventCard {
  id        String        @id @default(uuid())
  worldId   String
  eventId   String
  cardId    String
  role      String?
  createdAt DateTime      @default(now())

  world     World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [eventId, worldId], references: [id, worldId], onDelete: Cascade)
  card      Card          @relation(fields: [cardId, worldId], references: [id, worldId], onDelete: Cascade)

  @@unique([eventId, cardId])
  @@index([worldId, eventId])
  @@index([worldId, cardId])
  @@map("timeline_event_cards")
}

model DocumentVersion {
  id            String    @id @default(uuid())
  worldId       String
  documentId    String
  cardId        String
  versionNumber Int
  titleSnapshot String
  contentJson   Json
  plainText     String    @default("") @db.Text
  label         String?
  createdById   String?
  createdAt     DateTime  @default(now())

  world         World     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  card          Card      @relation(fields: [cardId, worldId], references: [id, worldId], onDelete: Cascade)
  document      Document  @relation(fields: [documentId, worldId], references: [id, worldId], onDelete: Cascade)

  @@unique([id, worldId])
  @@index([worldId, cardId])
  @@index([worldId, documentId])
  @@map("document_versions")
}

