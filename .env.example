# Database & Cache
DATABASE_URL="postgresql://dev_user:dev_password@localhost:5432/worldbuilding_db?schema=public"
REDIS_URL="redis://localhost:6379"

# API Settings
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# JWT Secrets
JWT_ACCESS_SECRET="dev_access_secret_super_secure_key_123456"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_key_654321"
JWT_REFRESH_EXPIRES_DAYS=7

# Email Transacional (Resend ou SMTP)
RESEND_API_KEY="re_mock_key"
EMAIL_FROM="noreply@seudominio.com"

# Storage Cloudflare R2
R2_ACCOUNT_ID="mock_account_id"
R2_ACCESS_KEY_ID="mock_access_key"
R2_SECRET_ACCESS_KEY="mock_secret_key"
R2_BUCKET_NAME="worldbuilding-assets"
R2_PUBLIC_URL="https://assets.seudominio.com"

